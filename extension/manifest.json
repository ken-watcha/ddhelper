{
  "manifest_version": 3,
  "name": "DDhelper Capture",
  "version": "0.3.2",
  "description": "DDhelper 디자인 QA 도구를 위한 스테이징 viewport별 자동 캡처. 본인 크롬 세션을 그대로 사용해 로그인된 페이지도 안전하게 캡처합니다.",

  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab",
    "windows"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "DDhelper Capture",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://localhost:3001/*",
      "https://ddhelper-two.vercel.app/*",
      "https://*.vercel.app/*"
    ]
  },

  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://localhost:3001/*",
        "https://ddhelper-two.vercel.app/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
